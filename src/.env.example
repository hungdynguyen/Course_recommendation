# ===================================================
# .env.example – copy thành .env và điền giá trị thực
# ===================================================

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Elasticsearch
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=course_skills

# Embedding model
EMBEDDING_DEVICE=cpu
# EMBEDDING_MODEL_PATH=models/qwen_embedding_finetuned  # uncomment để dùng local model

# gap detection
GAP_SIMILARITY_THRESHOLD=0.80
SKILL_SEARCH_LIMIT=3
