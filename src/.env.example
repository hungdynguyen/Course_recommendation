# ===================================================
# .env.example – copy thành .env và điền giá trị thực
# ===================================================

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vietcv
DB_USER=vietcv_user
DB_PASSWORD=secure_password

# Elasticsearch
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_VECTOR_DIM=1024

# S3/Minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vietcv
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Embedding model
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_MODEL_PATH=models/qwen_embedding_finetuned  # uncomment để dùng local model
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# Airflow
AIRFLOW_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Logging
LOG_LEVEL=INFO
