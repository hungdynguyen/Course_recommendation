# ============================================================
# Dockerfile – FastAPI Service (port 8000)
# Serves admin + user routes, recommendations, health checks
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY src/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Copy source code (overridden by volume mount in dev)
COPY src/ /app/src/

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1

# Run API server
CMD ["uvicorn", "service_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
